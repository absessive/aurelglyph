{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurelglyph.absessive.com/schemas/component-manifest.schema.json",
  "title": "Aurelglyph component manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "release", "scope", "platforms", "components"],
  "properties": {
    "$schema": { "const": "./schemas/component-manifest.schema.json" },
    "schemaVersion": { "const": 1 },
    "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "scope": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["css", "react", "reactNative", "swiftUI", "rails"]
          },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "introduced", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "introduced": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["css", "react", "reactNative", "swiftUI", "rails"],
            "properties": {
              "css": { "type": "string", "minLength": 1 },
              "react": { "type": "string", "minLength": 1 },
              "reactNative": { "type": "string", "minLength": 1 },
              "swiftUI": { "type": "string", "minLength": 1 },
              "rails": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
