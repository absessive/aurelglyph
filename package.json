{
  "name": "aurelglyph",
  "version": "0.4.1",
  "private": true,
  "description": "A token-first UX design language and component system for SwiftUI, React, React Native, and Rails.",
  "type": "module",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "build": "npm run build:assets && npm run build --workspaces --if-present",
    "build:assets": "node --experimental-strip-types scripts/font-assets.ts",
    "build:pages": "node --experimental-strip-types scripts/pages.ts",
    "build:tokens": "npm run build -w @aurelglyph/tokens",
    "test": "vitest run",
    "test:rails": "npm test -w aurelglyph-rails",
    "test:swift": "swift test --package-path packages/swift",
    "test:watch": "vitest",
    "typecheck": "npm run build:tokens && tsc -p tsconfig.base.json --noEmit",
    "version:check": "tsx scripts/versioning.ts check",
    "version:sync": "tsx scripts/versioning.ts sync",
    "verify": "npm run version:check && npm run build && npm run build:pages && npm test && npm run test:rails && npm run test:swift && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5"
  }
}
