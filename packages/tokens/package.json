{
  "name": "@aurelglyph/tokens",
  "version": "0.8.0",
  "description": "Canonical cross-platform design tokens for the Aurelglyph design system.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "aurelglyph",
    "design-system",
    "design-tokens",
    "css",
    "react-native",
    "swiftui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absessive/aurelglyph.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://aurelglyph.absessive.com/",
  "bugs": {
    "url": "https://github.com/absessive/aurelglyph/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/tokens.json",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated.css": "./dist/generated/aurelglyph.css",
    "./tokens": {
      "types": "./dist/generated/tokens.d.ts",
      "default": "./dist/generated/tokens.js"
    },
    "./react-native": {
      "types": "./dist/generated/react-native.d.ts",
      "default": "./dist/generated/react-native.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsx src/build.ts && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run --root ../.. packages/tokens/src/build.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.4"
  }
}
