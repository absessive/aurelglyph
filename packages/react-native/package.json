{
  "name": "@aurelglyph/react-native",
  "version": "0.8.1",
  "description": "Accessible React Native components for the Aurelglyph cross-platform design system.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "aurelglyph",
    "react-native",
    "design-system",
    "components",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absessive/aurelglyph.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://aurelglyph.absessive.com/",
  "bugs": {
    "url": "https://github.com/absessive/aurelglyph/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "react-native": "./dist/fonts.js",
      "default": "./dist/fonts.js"
    }
  },
  "files": [
    "dist",
    "assets/fonts",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run build -w @aurelglyph/tokens && node --experimental-strip-types ../../scripts/font-assets.ts && tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/react-native/src",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@aurelglyph/tokens": "0.8.1"
  },
  "peerDependencies": {
    "react": ">=19.2.3 <20",
    "react-native": ">=0.86.0 <0.88.0",
    "react-native-safe-area-context": ">=5.5.2 <6"
  },
  "devDependencies": {
    "@types/react": "^19.1.1",
    "react": "^19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "^5.5.2"
  }
}
