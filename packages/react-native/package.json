{
  "name": "@aurelglyph/react-native",
  "version": "0.4.1",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fonts": {
      "types": "./src/fonts.ts",
      "default": "./src/fonts.ts"
    }
  },
  "files": [
    "src",
    "assets/fonts",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "npm run build -w @aurelglyph/tokens && node --experimental-strip-types ../../scripts/font-assets.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@aurelglyph/tokens": "0.4.1"
  }
}
