{
  "name": "@aurelglyph/react",
  "version": "0.8.1",
  "description": "Accessible React components for the Aurelglyph cross-platform design system.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "aurelglyph",
    "react",
    "design-system",
    "components",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absessive/aurelglyph.git",
    "directory": "packages/react"
  },
  "homepage": "https://aurelglyph.absessive.com/",
  "bugs": {
    "url": "https://github.com/absessive/aurelglyph/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "sideEffects": [
    "*.css",
    "dist/*.css",
    "src/*.css"
  ],
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "dependencies": {
    "@aurelglyph/tokens": "0.8.1"
  }
}
